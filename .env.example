POSTCODE="NE30 3SB"
WHATSAPP_TO=07791851722
WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_ALERT_WEBHOOK_URL=
WHATSAPP_ALERT_WEBHOOK_TOKEN=
OPENCLAW_GATEWAY_TOKEN=<FILL_OPENCLAW_GATEWAY_TOKEN>
OPENCLAW_TOOL_URL=http://127.0.0.1:28889/tools/invoke
# Facebook Marketplace search (used by `npm run search`) via fb-browser-worker.
BROWSER_WORKER_URL=http://100.95.126.123:3877
BROWSER_WORKER_TOKEN=<FILL_BROWSER_WORKER_TOKEN>
# Optional: Facebook location/area id for more localized marketplace results.
MARKETPLACE_AREA_ID=
# Watches are the single source of truth; edit via `npm run watches -- ...`.
# MARKET_WATCHES_FILE selects which watch file a run uses (per chat).
MARKET_WATCHES_FILE=config/watches.json

# The browser worker runs natively on the Windows host and dies with the desktop
# session. When a cycle finds it unreachable it invokes this command and waits.
BROWSER_WORKER_AUTOSTART_ENABLED=true
BROWSER_WORKER_AUTOSTART_COMMAND=/mnt/c/Windows/System32/cmd.exe /c "cd /d C:\fb-browser-worker && npm.cmd run start:if-needed"
BROWSER_WORKER_STARTUP_TIMEOUT_MS=90000
BROWSER_WORKER_RESTART_COOLDOWN_MS=300000

# Silence looks identical to "nothing new today", so shout after N failed cycles.
HEALTH_STATE_PATH=.data/health-state.json
DEGRADED_ALERT_AFTER_FAILURES=3

# Listing detail pages: needed for triage, off until triage consumes them.
# Fetching is serial with a delay to stay under Facebook's rate limiting.
DETAIL_FETCH_ENABLED=false
DETAIL_MAX_PER_CYCLE=15
DETAIL_DELAY_MS=1500
DETAIL_CACHE_PATH=.data/listing-details.json
SCRAPE_INTERVAL_SECONDS=3600
HTTP_TIMEOUT_MS=15000
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000
DATA_PATH=.data/seen-listings.json
DEDUPE_RETENTION_DAYS=30
DEDUPE_MAX_ENTRIES=5000
DIAGNOSTICS_LOG_PATH=.data/diagnostics.log
DELIVERY_CANARY_ENABLED=true
DELIVERY_CANARY_FIXTURE_PATH=test/fixtures/gumtree-search-stable.html
DELIVERY_CANARY_KEYWORD=lawnmower
HEALTH_METRICS_ENABLED=false
HEALTH_METRICS_HOST=127.0.0.1
HEALTH_METRICS_PORT=9464
HEALTH_METRICS_TOKEN=
HEALTH_MAX_STALENESS_SECONDS=0
DRY_RUN=false